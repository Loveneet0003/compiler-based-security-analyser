{
  "name": "security-analyzer",
  "displayName": "Compiler-Assisted Security Analyzer",
  "description": "Static security analyzer to detect vulnerabilities during compilation",
  "publisher": "college-project",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/college-project/security-analyzer.git"
  },
  "license": "MIT",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "security-analyzer.analyze",
        "title": "Security Analyzer: Analyze Current File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "analyze": "npm run compile-tests && node test-cli.js"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "path-browserify": "^1.0.1",
    "tree-sitter-c": "^0.20.6",
    "tree-sitter-cpp": "^0.20.3",
    "tree-sitter-javascript": "^0.20.1",
    "tree-sitter-typescript": "^0.20.3",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  }
}
